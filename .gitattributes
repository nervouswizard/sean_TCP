# 預設：讓 Git 自動偵測文字檔，repo 內一律以 LF 儲存
* text=auto

# 原始碼與設定檔：工作區也統一使用 LF
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf

# Windows 批次檔必須是 CRLF 才能正確執行
*.bat   text eol=crlf

# 二進位檔：不做任何換行轉換
*.png   binary
*.jpg   binary
*.jpeg  binary
*.npy   binary
*.pth   binary
*.ckpt  binary
*.safetensors binary

# 點雲檔雖為 ASCII，但內容為大量座標，不做換行轉換也不產生 diff
*.ply   binary
